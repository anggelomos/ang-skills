#!/usr/bin/env bash
# Best-effort webhook sender. Deliberately uses only Bash and curl.

log_mode=manual
log_reason=unknown
log_http=-
log_curl=-
log_invocation() {
  local log_dir=${XDG_CACHE_HOME:-$HOME/.cache}/grokbot-ping
  if mkdir -p -- "$log_dir" 2>/dev/null; then
    printf '%s mode=%s reason=%s http=%s curl_exit=%s\n' \
      "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$log_mode" "$log_reason" "$log_http" "$log_curl" \
      >> "$log_dir/log" 2>/dev/null || :
  fi
}
finish() { log_reason=$1; exit "${2:-0}"; }
trap log_invocation EXIT

to=fabro
to_set=0
from=manual
status=done
thread=${T3_THREAD_ID:-${T3_CODE_THREAD_ID:-${T3CODE_THREAD_ID:-}}}
session=
message=
adapter=
payload=
force=0
mode=send

if [[ ${1:-} == enable || ${1:-} == disable ]]; then
  mode=$1
  log_mode=$mode
  shift
fi

while (($#)); do
  case $1 in
    --to|--from|--status|--thread|--session)
      (($# >= 2)) || finish invalid_args
      case $1 in
        --to) to=$2; to_set=1 ;; --from) from=$2 ;; --status) status=$2 ;;
        --thread) thread=$2 ;; --session) session=$2 ;;
      esac
      shift 2 ;;
    --claude-stop) adapter=claude; log_mode=claude-stop; shift ;;
    --codex-notify) adapter=codex; log_mode=codex-notify; shift; (($#)) || finish invalid_args; payload=${!#}; break ;;
    --opencode-idle) log_mode=opencode-idle; finish unsupported_adapter ;; # No verified shared key.
    --force) force=1; log_mode=manual-force; shift ;;
    --) shift; message="$*"; break ;;
    -*) finish invalid_args ;;
    *) message="$*"; break ;;
  esac
done

if [[ $adapter == claude ]]; then log_mode=claude-stop
elif [[ $adapter == codex ]]; then log_mode=codex-notify; fi

[[ $to =~ ^[a-zA-Z0-9_-]+$ ]] || finish invalid_target

# Bash tool calls share these IDs with their corresponding hook payloads.
# A missing ID is never replaced with cwd, which can belong to many sessions.
session_kind=
session_key=
if [[ -n ${CLAUDE_CODE_SESSION_ID:-} ]]; then
  session_kind=claude; session_key=$CLAUDE_CODE_SESSION_ID
elif [[ -n ${CODEX_THREAD_ID:-} ]]; then
  session_kind=codex; session_key=$CODEX_THREAD_ID
fi
[[ $session_key =~ ^[A-Za-z0-9._-]+$ ]] || session_key=

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/grokbot-ping
now=$(date +%s)
if [[ -d $state_dir ]]; then
  for old_marker in "$state_dir"/claude-* "$state_dir"/codex-*; do
    [[ -f $old_marker ]] || continue
    modified=$(date -r "$old_marker" +%s 2>/dev/null) || continue
    if ((now-modified > 604800)); then rm -f -- "$old_marker" 2>/dev/null || :; fi
  done
fi

if [[ $mode != send ]]; then
  if [[ -z $session_key ]]; then
    printf 'grokbot-ping: no supported agent session ID in this shell\n' >&2
    finish no_session_id 2
  fi
  marker=$state_dir/$session_kind-$session_key
  if [[ $mode == disable ]]; then
    rm -f -- "$marker" || finish failed_state 2
    printf 'grokbot-ping disabled for this session\n'
    finish disabled
  else
    umask 077
    mkdir -p -- "$state_dir" || finish failed_state 2
    printf '%s\n' "$to" > "$marker" || finish failed_state 2
    printf 'grokbot-ping enabled for this session: %s\n' "$to"
    finish enabled
  fi
fi

json_quote() {
  local value=$1 char output='"' i hex
  for ((i=0; i<${#value}; i++)); do
    char=${value:i:1}
    case $char in
      '"') output+='\"' ;; '\') output+='\\' ;;
      $'\n') output+='\n' ;; $'\r') output+='\r' ;; $'\t') output+='\t' ;;
      $'\b') output+='\b' ;; $'\f') output+='\f' ;;
      [[:cntrl:]]) printf -v hex '%02x' "'$char"; output+="\\u00$hex" ;;
      *) output+=$char ;;
    esac
  done
  JSON_VALUE=${output}'"'
}

# Return a string value as its original, valid JSON token. Hook payloads are
# small JSON objects; this avoids jq, Python, and lossy shell unescaping.
json_field_raw() {
  local key=$1 marker rest char escaped=0 i raw='"'
  JSON_FIELD=null
  marker='"'${key}'"'
  [[ $payload == *"$marker"* ]] || return
  rest=${payload#*"$marker"}
  [[ $rest =~ ^[[:space:]]*: ]] || return
  rest=${rest#*:}
  rest="${rest#"${rest%%[![:space:]]*}"}"
  [[ ${rest:0:1} == '"' ]] || return
  for ((i=1; i<${#rest}; i++)); do
    char=${rest:i:1}
    raw+=$char
    if ((escaped)); then escaped=0
    elif [[ $char == '\' ]]; then escaped=1
    elif [[ $char == '"' ]]; then JSON_FIELD=$raw; return
    fi
  done
}

truncate_json_string() {
  local raw=${1:1:${#1}-2} output='"' char i=0 count=0 step
  while ((i<${#raw} && count<500)); do
    char=${raw:i:1}; step=1
    if [[ $char == '\' ]]; then
      if [[ ${raw:i+1:1} == u ]]; then step=6; else step=2; fi
    fi
    output+=${raw:i:step}
    ((i+=step, count++))
  done
  JSON_VALUE=${output}'"'
}

message_json=
thread_json=
session_json=
hook_session_id=
if [[ $adapter == claude ]]; then
  payload=$(</dev/stdin)
  json_field_raw session_id; session_json=$JSON_FIELD
  if [[ $JSON_FIELD != null ]]; then hook_session_id=${JSON_FIELD:1:${#JSON_FIELD}-2}; fi
  json_field_raw last_assistant_message
  [[ $JSON_FIELD == null ]] || { truncate_json_string "$JSON_FIELD"; message_json=$JSON_VALUE; }
elif [[ $adapter == codex ]]; then
  json_field_raw type
  [[ $JSON_FIELD == '"agent-turn-complete"' ]] || finish ignored_event
  json_field_raw thread-id; thread_json=$JSON_FIELD
  if [[ $JSON_FIELD != null ]]; then hook_session_id=${JSON_FIELD:1:${#JSON_FIELD}-2}; fi
  json_field_raw turn-id; session_json=$JSON_FIELD
  json_field_raw last-assistant-message
  [[ $JSON_FIELD == null ]] || { truncate_json_string "$JSON_FIELD"; message_json=$JSON_VALUE; }
fi

# Automatic hooks use the authoritative ID from their payload. Deliberate
# sends use the ID exported to the agent's shell. Both must find one marker.
if [[ -n $adapter ]]; then
  [[ $hook_session_id =~ ^[A-Za-z0-9._-]+$ ]] || finish no_session_id
  marker=$state_dir/$adapter-$hook_session_id
elif ((force == 0)); then
  [[ -n $session_key ]] || finish no_session_id
  marker=$state_dir/$session_kind-$session_key
fi
if [[ -n $adapter ]] || ((force == 0)); then
  [[ -f $marker ]] || finish no_marker
  IFS= read -r enabled_to < "$marker" || finish invalid_marker
  [[ $enabled_to =~ ^[A-Za-z0-9_-]+$ ]] || finish invalid_marker
  if ((to_set)) && [[ $to != "$enabled_to" ]]; then finish target_mismatch; fi
  to=$enabled_to
fi

config=${XDG_CONFIG_HOME:-$HOME/.config}/grokbot-ping/$to.env
[[ -f $config ]] || finish no_env

# The per-user file is trusted shell syntax; keep it private (chmod 600).
# shellcheck disable=SC1090
. "$config"
[[ -n ${GROKBOT_PING_URL:-} && -n ${GROKBOT_PING_KEY:-} ]] || finish no_env

if [[ -z $thread_json ]]; then
  if [[ -n $thread ]]; then json_quote "$thread"; thread_json=$JSON_VALUE
  else thread_json=null; fi
fi
if [[ -z $session_json ]]; then
  if [[ -n $session ]]; then json_quote "$session"; session_json=$JSON_VALUE
  else session_json=null; fi
fi
if [[ -z $message_json ]]; then json_quote "$message"; message_json=$JSON_VALUE; fi

cwd=$PWD
root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || root=$cwd
project=${root##*/}
ts=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
json_quote "$to"; to_json=$JSON_VALUE
json_quote "$from"; from_json=$JSON_VALUE
json_quote "$status"; status_json=$JSON_VALUE
json_quote "$cwd"; cwd_json=$JSON_VALUE
json_quote "$project"; project_json=$JSON_VALUE
json_quote "$ts"; ts_json=$JSON_VALUE
body="{\"to\":$to_json,\"from\":$from_json,\"status\":$status_json,\"thread_id\":$thread_json,\"session_id\":$session_json,\"cwd\":$cwd_json,\"project\":$project_json,\"message\":$message_json,\"ts\":$ts_json}"

header=${GROKBOT_PING_KEY_HEADER:-Authorization}
[[ $header =~ ^[A-Za-z0-9-]+$ ]] || finish invalid_header
if [[ $header == Authorization ]]; then
  auth="Authorization: Bearer $GROKBOT_PING_KEY"
else
  auth="$header: $GROKBOT_PING_KEY"
fi

http_code=$(curl --silent --output /dev/null --write-out '%{http_code}' \
  --connect-timeout 2 --max-time 5 --request POST \
  --header 'Content-Type: application/json' --header "$auth" \
  --data-binary "$body" "$GROKBOT_PING_URL" 2>/dev/null)
curl_status=$?
log_http=${http_code:-000}
log_curl=$curl_status
if ((curl_status != 0)) || [[ ! $http_code =~ ^2[0-9][0-9]$ ]]; then finish failed; fi
finish sent
